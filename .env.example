# =============================================================================
# Agent Kernel Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database / Storage
# -----------------------------------------------------------------------------
# Store backend: "sqlite" (local-first, default) or "postgres" (cloud)
STORE_BACKEND=sqlite

# SQLite (default, local-first)
DATABASE_URL=sqlite+aiosqlite:///./data/agent_kernel.db

# PostgreSQL (optional, for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_kernel

# --- PostgreSQL settings (used when STORE_BACKEND=postgres) ---
# SUPABASE_DB_HOST=db.your-project.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-database-password

# Connection pool sizing
# POSTGRES_MIN_CONNECTIONS=1
# POSTGRES_MAX_CONNECTIONS=10

# Vector Store ("auto" selects LanceDB when available, falls back to SQLite)
# Options: auto | lancedb | sqlite
VECTOR_STORE_TYPE=auto

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Default LLM provider (openai | anthropic | azure | local)
DEFAULT_LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# Tool Broker Configuration
# -----------------------------------------------------------------------------
# Maximum concurrent tool executions
TOOL_BROKER_MAX_CONCURRENCY=5

# Default timeout for tool calls (milliseconds)
TOOL_BROKER_DEFAULT_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Tracing & Observability
# -----------------------------------------------------------------------------
# Trace storage location
TRACE_STORE_PATH=./data/traces

# Enable trace mirroring to JSONL
TRACE_JSONL_ENABLED=true
TRACE_JSONL_PATH=./data/traces/traces.jsonl

# Optional: Remote trace sink
# TRACE_REMOTE_SINK_URL=https://your-trace-collector.example.com

# -----------------------------------------------------------------------------
# Memory Subsystem
# -----------------------------------------------------------------------------
# Document store path
DOCUMENT_STORE_PATH=./data/documents

# Event log path
EVENT_LOG_PATH=./data/events

# Graph store (sqlite | neo4j)
GRAPH_STORE_TYPE=sqlite

# -----------------------------------------------------------------------------
# Context Assembler
# -----------------------------------------------------------------------------
# Default budget limits for context assembly
CONTEXT_MAX_TOKENS=8000
CONTEXT_MAX_ITEMS=50
CONTEXT_MAX_NOTES=20
CONTEXT_MAX_TASKS=30
CONTEXT_MAX_EVENTS=10

# -----------------------------------------------------------------------------
# Skills (portable procedural guidance)
# -----------------------------------------------------------------------------
SKILLS_DIR=~/.agent_kernel/skills
SKILLS_ENABLE_SCRIPTS=false
SKILLS_ALLOWED_SCRIPT_SKILLS=
SKILLS_ALLOWED_SCRIPT_ORIGINS=local
SKILLS_SCRIPT_EXTENSIONS=.py
SKILLS_SCRIPT_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Workflow & Scheduler
# -----------------------------------------------------------------------------
# Scheduler timezone (IANA format)
SCHEDULER_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Obsidian Integration
# -----------------------------------------------------------------------------
# Path to your Obsidian vault (required for vault-sync and enrichment)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# -----------------------------------------------------------------------------
# Enrichment (Auto-Tagging)
# -----------------------------------------------------------------------------
# LLM model for generating auto-tags and classification
ENRICHMENT_MODEL=gpt-4o-mini

# Temperature for LLM (lower = more consistent)
ENRICHMENT_TEMPERATURE=0.3

# Max content length to send to LLM (characters)
ENRICHMENT_MAX_CONTENT_LENGTH=4000

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Model for generating vector embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Vector dimensions (must match model output)
EMBEDDING_DIMENSIONS=1536

# Chunking parameters for embedding
EMBEDDING_CHUNK_SIZE=500
EMBEDDING_CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Summarization Thresholds
# -----------------------------------------------------------------------------
# Minimum character count to trigger summarization (0 = disabled)
SUMMARIZATION_MIN_CHARS=500

# Minimum word count to trigger summarization (0 = disabled)
SUMMARIZATION_MIN_WORDS=100

# Folders to exclude from summarization (comma-separated)
SUMMARIZATION_EXCLUDED_FOLDERS=Daily Notes/,Journal/

# Tags that exclude a note from summarization (comma-separated)
SUMMARIZATION_EXCLUDED_TAGS=no-summary,private

# Classifications to exclude from summarization (comma-separated)
SUMMARIZATION_EXCLUDED_CLASSIFICATIONS=journal,daily-note

# Tags that force summarization even if otherwise excluded (comma-separated)
SUMMARIZATION_FORCE_INCLUDE_TAGS=summarize,important

# Behavior when excluded: skip_entirely | enrich_no_summary
SUMMARIZATION_SKIP_BEHAVIOR=enrich_no_summary

# -----------------------------------------------------------------------------
# Security & Approval
# -----------------------------------------------------------------------------
# Require approval for external writes by default
REQUIRE_APPROVAL_EXTERNAL_WRITES=true

# Auto-approve read-only operations
AUTO_APPROVE_READ_ONLY=true

# Approval notification channel ("log" or "" to disable)
APPROVAL_NOTIFY_CHANNEL=

flowchart LR
    subgraph USERS["Consumers"]
        USER["Data Engineer /<br/>Agent Operator"]
        MARTEK["MarTek Agent<br/>(Generosity Intelligence)"]
        PIPELINE["Pipeline Agent<br/>(Data Engineering)"]
    end

    subgraph KERNEL["Agent Kernel"]
        ENGINE["Agent Engine"]
        CG["Context Graph<br/>(9 components)"]
        CA["Context Assembler"]
        EXEC["Executor + Tool Broker"]
        TRACE["Trace Store"]
    end

    subgraph STORES["Backing Stores"]
        GRAPHDB["LakebaseGraphStore<br/>(Managed PostgreSQL)"]
        DOCDB["Document Store"]
        VECDB["Vector Store"]
        EXPDB["Experience Store"]
    end

    subgraph SOURCES["Data Sources"]
        SSOT["Databricks SSOT<br/>(Core Layer)"]
        DOCSRC["Jira / Confluence /<br/>Git Docs"]
    end

    subgraph PEERS["Data Platform"]
        C360["Customer 360"]
        RECSYS["Recommender Systems"]
        UC["Unity Catalog"]
        BT["Braintrust<br/>(Prompts + Eval + Review)"]
    end

    subgraph QSVC["Queryable Services"]
        ODDS["Odds Feeds"]
        BETTING["Betting Platform"]
        PROMO["Promotion Engine"]
    end

    USER --> ENGINE
    MARTEK --> ENGINE
    PIPELINE --> ENGINE

    ENGINE --> CA
    CA --> CG
    CG --> GRAPHDB
    CA --> DOCDB
    CA --> VECDB
    CA --> EXPDB

    EXEC --> TRACE
    TRACE --> CG

    SOURCES -->|"Table metadata<br/>+ documents"| CG
    C360 -.->|"Entity enrichment"| CG
    RECSYS -.->|"Shared entities"| CG

    BT -.->|"Prompts + versioning"| ENGINE
    BT -.->|"Eval signals"| EXPDB
    GRAPHDB -.->|"Sync Tables"| SSOT
    GRAPHDB -.-> UC

    ENGINE -.->|"via tools/skills"| QSVC

